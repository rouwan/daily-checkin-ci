{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "perspective",
    "summary",
    "findings",
    "limitations"
  ],
  "properties": {
    "perspective": {
      "type": "string",
      "enum": [
        "correctness",
        "work_necessity"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 800
    },
    "findings": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "priority",
          "title",
          "file",
          "line",
          "impact",
          "evidence",
          "recommendation"
        ],
        "properties": {
          "priority": {
            "type": "string",
            "enum": [
              "P1",
              "P2",
              "P3"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "file": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 240
          },
          "line": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "impact": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "evidence": {
            "type": "string",
            "minLength": 1,
            "maxLength": 800
          },
          "recommendation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      }
    }
  }
}
